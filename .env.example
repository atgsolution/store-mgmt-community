# Docker/production must use the PostgreSQL-backed API.
# For frontend-only Vite development, override this to false in the shell.
VITE_API_ENABLED=true

# Store identity. These values are safe examples, not secrets.
STORE_CODE=default
STORE_ID=00000000-0000-0000-0000-000000000001
STORE_NAME=Store A
STORE_ADDRESS=HCM City
STORE_PHONE=123 123
STORE_FOOTER=Thank you

# Required scrypt hashes used only when creating accounts in a fresh database.
# Generate them with scripts/setup-linux.sh. Never put plaintext passwords here.
STAFF_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# A session lasts 7 days; each account can keep at most 10 active sessions.
SESSION_TTL_HOURS=168

# Required secrets. Generate unique values, for example with: openssl rand -base64 32
DB_USER=store_mgmt
HOT_DB_NAME=store_mgmt_hot
ARCHIVE_DB_NAME=store_mgmt_archive
HOT_DB_PASSWORD=
ARCHIVE_DB_PASSWORD=
APP_PORT=6086
HOT_DB_PORT=127.0.0.1:55432
ARCHIVE_DB_PORT=127.0.0.1:55433

# Local backend URLs. Replace PASSWORD before running outside Docker.
HOT_DATABASE_URL=postgres://store_mgmt:PASSWORD@127.0.0.1:55432/store_mgmt_hot
ARCHIVE_DATABASE_URL=postgres://store_mgmt:PASSWORD@127.0.0.1:55433/store_mgmt_archive
COLD_ARCHIVE_DIR=./data/store-mgmt-cold-archive
COLD_ARCHIVE_DELETE_SOURCE=false
COOKIE_SECURE=false
